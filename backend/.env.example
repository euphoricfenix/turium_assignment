# Copy to backend/.env and fill in a real key.
OPENAI_API_KEY=

# Models
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Chunking and retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DEFAULT_TOP_K=4
# Cosine score below which retrieved chunks count as unrelated to the question.
RELEVANCE_FLOOR=0.30

# URL ingestion
FETCH_TIMEOUT_SECONDS=20
MAX_MARKDOWN_CHARS=20000

# Server
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
